{
  "name": "hm-website-worker",
  "version": "1.0.0",
  "description": "Her Motorsport website rewritten as a Cloudflare Worker with Static Assets and D1 Edge Database",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "tsc --noEmit",
    "test": "node --import ./test/register-stub.mjs --test test/sync.test.ts test/hub.test.ts",
    "db:init:local": "wrangler d1 execute hm-db --local --file=src/db/schema.sql",
    "db:init:remote": "wrangler d1 execute hm-db --remote --file=src/db/schema.sql"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241004.0",
    "typescript": "^5.5.0",
    "wrangler": "^3.80.0"
  }
}
